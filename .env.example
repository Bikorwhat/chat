# Optional TURN relay. Leave blank to use direct connections plus STUN.
# Obtain real URLs and credentials from a provider or your own coturn server.
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
# For coturn shared-secret authentication, use this instead of username/password.
# This signing secret stays on the server; browsers receive one-hour credentials.
TURN_SECRET=
# Use true only with a working relay to verify calls cannot use direct connections.
TURN_RELAY_ONLY=false
CALL_COOLDOWN_MS=10000
# Optional override of the default discovery server.
STUN_URL=stun:stun.l.google.com:19302
